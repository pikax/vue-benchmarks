# Dependencies
node_modules/
.pnpm-store/

# Generated benchmark corpora (recreate with `pnpm generate`)
/fixtures/*
!/fixtures/.gitkeep

# Large optional E2E clone
/fixtures/e2e/nuxt-ui/

# Ephemeral workspaces / probe output
/work/
# bench.mjs falls back to work-<pid>-<timestamp> when Windows file locks stop it
# wiping /work/ — those fallback dirs are ephemeral too and must not be tracked.
/work-*/

# Local report outputs (win32, logs, ci-tmp). Latest Linux CI snapshot IS committed.
/results/*
!/results/.gitkeep
!/results/README.md
!/results/benchmarks/
!/results/benchmarks/**
!/results/real_world/
!/results/real_world/**

# VS Code test runner download cache
.vscode-test/

# Tooling / OS noise
.bench-temp.json
*.tgz
*.log
.DS_Store
Thumbs.db
dist/
target/
.env
.env.*
!.env.example

# Editor / IDE
.idea/
*.swp
*.swo
