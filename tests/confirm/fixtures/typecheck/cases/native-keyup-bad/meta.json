{
  "id": "native-keyup-bad",
  "description": "@keyup handler typed as MouseEvent must not accept a KeyboardEvent",
  "expectErrors": true,
  "minErrors": 1,
  "mustMatch": ["TS2322", "TS2345", "KeyboardEvent", "MouseEvent", "not assignable"],
  "requires": ["dom-events"],
  "expectMention": ["KeyboardEvent"]
}
