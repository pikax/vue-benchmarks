{
  "name": "vue-benchmarks",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tool benchmarks for Vue SFC/JSX compilers, typecheckers, formatters, linters, component-meta, and LSP.",
  "keywords": [
    "benchmark",
    "compiler",
    "jsx",
    "lsp",
    "typecheck",
    "verter",
    "vize",
    "volar",
    "vue",
    "vue-jsx-vapor"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:small": "node scripts/generate.mjs --counts 50,200",
    "generate:ci": "node scripts/generate.mjs --counts 200,1000",
    "bench": "node scripts/bench.mjs",
    "bench:small": "node scripts/bench.mjs --fixture fixtures/50 --runs 2 --warmups 1",
    "bench:quick": "node scripts/bench.mjs --runs 3 --warmups 1",
    "bench:deep": "node scripts/bench.mjs --runs 9 --warmups 2",
    "bench:compile": "node scripts/bench.mjs --surfaces compile",
    "bench:compile:single": "node scripts/bench-compile-single.mjs",
    "bench:jsx-compile": "node scripts/bench.mjs --surfaces jsx-compile",
    "bench:compile:repeated": "node scripts/bench.mjs --surfaces compile --fixture fixtures/50-repeated --compile-targets vdom --compile-envs production",
    "bench:typecheck": "node scripts/bench.mjs --surfaces typecheck",
    "bench:format": "node scripts/bench.mjs --surfaces format",
    "bench:lint": "node scripts/bench.mjs --surfaces lint",
    "bench:component-meta": "node scripts/bench.mjs --surfaces component-meta",
    "bench:lsp": "node scripts/bench.mjs --surfaces lsp --runs 3 --warmups 1",
    "bench:memory": "node --expose-gc scripts/bench-memory.mjs",
    "bench:memory:small": "node --expose-gc scripts/bench-memory.mjs --fixture fixtures/20 --file-limit 20 --samples 2",
    "e2e:setup": "node scripts/e2e-vscode/setup-workspaces.mjs",
    "e2e:setup:nuxt-ui": "node scripts/e2e-vscode/setup-workspaces.mjs --with-nuxt-ui",
    "e2e:install-extensions": "node scripts/e2e-vscode/install-extensions.mjs",
    "e2e:vscode": "node scripts/e2e-vscode/run.mjs --with-setup",
    "e2e:vscode:full": "node scripts/e2e-vscode/run.mjs --with-setup-nuxt-ui --workspaces regular,monorepo,nuxt-ui",
    "update-readme": "node scripts/update-readme.mjs",
    "update-memory-readme": "node scripts/update-memory-readme.mjs",
    "test:harness": "node tests/harness/run.mjs",
    "confirm": "node tests/confirm/run.mjs",
    "confirm:compile": "node tests/confirm/run.mjs --surfaces compile",
    "confirm:jsx-compile": "node tests/confirm/run.mjs --surfaces jsx-compile",
    "confirm:lint": "node tests/confirm/run.mjs --surfaces lint",
    "confirm:typecheck": "node tests/confirm/run.mjs --surfaces typecheck",
    "confirm:component-meta": "node tests/confirm/run.mjs --surfaces component-meta",
    "smoke": "node scripts/generate.mjs --counts 20 && node scripts/bench.mjs --fixture fixtures/20 --runs 2 --warmups 1 --surfaces compile,jsx-compile,lint,typecheck,format,component-meta,lsp --check-file-limit 20 --meta-file-limit 20",
    "check": "node tests/confirm/run.mjs",
    "prepublishOnly": "node -e \"console.error('This package is private and not published to npm.'); process.exit(1)\"",
    "bench:ide": "node scripts/ide-bench.mjs",
    "bench:ide:list": "node scripts/ide-bench.mjs --list",
    "bench:ide:quick": "node scripts/ide-bench.mjs --suite smoke,completion --server all --runs 1"
  },
  "dependencies": {
    "@babel/core": "7.28.5",
    "@golar/vue": "0.1.10",
    "@verter/component-meta": "0.0.1-beta.2",
    "@verter/native": "0.0.1-beta.2",
    "@vizejs/native": "0.291.0",
    "@vscode/test-electron": "2.5.2",
    "@vue-jsx-vapor/compiler-rs": "3.2.19",
    "@vue-jsx-vapor/eslint": "3.2.19",
    "@vue/babel-plugin-jsx": "2.0.1",
    "@vue/compiler-sfc": "3.5.40",
    "@vue/compiler-sfc-36": "npm:@vue/compiler-sfc@3.6.0-rc.2",
    "@vue/language-server": "3.3.8",
    "@vue/typescript-plugin": "3.3.8",
    "eslint": "9.39.2",
    "eslint-plugin-vue": "10.8.0",
    "golar": "0.1.10",
    "mocha": "11.7.5",
    "oxfmt": "0.60.0",
    "prettier": "3.9.6",
    "typescript-language-server": "5.3.0",
    "verter-tsc": "0.0.1-beta.2",
    "vize": "0.291.0",
    "vue": "3.5.40",
    "vue-component-meta": "3.3.8",
    "vue-jsx-vapor": "3.2.19",
    "vue-tsc": "3.3.8"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.65.0",
    "@vue/test-utils": "2.4.11",
    "jsdom": "29.1.1",
    "tinybench": "6.1.2",
    "typescript": "5.9.3",
    "typescript-go": "npm:typescript@7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0"
}
